prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

debug {
    honor-xdg-activation-with-invalid-serial
    ignore-drm-device "/dev/dri/renderD128"
    wait-for-frame-completion-before-queueing
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

include "config/10-input-and-cursor.kdl"
include "config/20-layout-and-overview.kdl"
include "config/30-window-rules.kdl"
include "config/40-environment.kdl"
include "config/50-startup.kdl"
include "config/60-animations.kdl"
include "config/70-binds.kdl"
include "config/90-user-extra.kdl"

include "noctalia.kdl"
