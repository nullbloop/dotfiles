// Input devices, gestures & cursor — keeps your existing preferences

input {
    keyboard {
        xkb {
            layout "pt"
            //options "grp:win_space_toggle"
        }
        repeat-delay 250
        repeat-rate 50
}
	focus-follows-mouse max-scroll-amount="0%"
   

    touchpad {
        tap
        tap-button-map "left-right-middle"
        natural-scroll
        accel-profile "flat"
        click-method "clickfinger"
    }

    mouse {
        accel-profile "flat"
        natural-scroll
    }

    mod-key "Super"
    mod-key-nested "Alt"
}

gestures {
    hot-corners {
        // off
    }
}

cursor {
    xcursor-theme "catppuccin-mocha-pink-cursors"
    xcursor-size 24
    hide-when-typing
}
