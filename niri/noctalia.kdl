layout {

    focus-ring {
        active-color   "#4cb9ff"
        inactive-color "#03243a"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#4cb9ff"
        inactive-color "#03243a"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#4cb9ff"
        inactive-color "#005d99"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#4cb9ff80"
    }
}

recent-windows {
    highlight {
        active-color "#4cb9ff"
        urgent-color "#fd4663"
    }
}
