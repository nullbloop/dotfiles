// Processes spawned at login — Noctalia Shell

// ── Noctalia shell (v5 launches directly as `noctalia`) ────
spawn-at-startup "noctalia"

// ── Clipboard history ─────────────────────────────────────
spawn-at-startup "bash" "-c" "wl-paste --type text --watch cliphist store"
spawn-at-startup "bash" "-c" "wl-paste --type image --watch cliphist store"

// ── EasyEffects equalizer ──────────────────────────────────
spawn-at-startup "systemctl" "--user" "enable" "--now" "easyeffects"

// ── KDE menu indexing for Qt apps ───────────────────────────
spawn-at-startup "bash" "-c" "systemctl --user import-environment XDG_MENU_PREFIX && kbuildsycoca6"

// ── PipeWire readiness ──────────────────────────────────────
spawn-at-startup "sh" "-c" "systemctl --user start pipewire pipewire-pulse wireplumber; until wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | grep -q Volume; do sleep 0.3; done"
