layout {

    focus-ring {
        active-color   "#7f67e4"
        inactive-color "#181429"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#7f67e4"
        inactive-color "#181429"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#7f67e4"
        inactive-color "#291485"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#7f67e480"
    }
}

recent-windows {
    highlight {
        active-color "#7f67e4"
        urgent-color "#fd4663"
    }
}
