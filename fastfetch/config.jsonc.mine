{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "separator": " "
    },
    "logo": {
    "source": "pearos",
    "padding": { "top": 1, "left": 2 },
    "color": {
        "1": "#d5c0d7",
        "2": "#f5b7b3"
    }},
    "modules": [
        {
            "type": "host",
            "key": "╭─󰌢",
            "keyColor": "#debece"
        },
        {
            "type": "cpu",
            "key": "├─󰻠",
            "keyColor": "#debece"
        },
        {
            "type": "gpu",
            "key": "├─󰍛",
            "keyColor": "#debece"
        },
        {
            "type": "disk",
            "key": "├─",
            "keyColor": "#debece"
        },
        {
            "type": "memory",
            "key": "├─󰑭",
            "keyColor": "#debece"
        },
        {
            "type": "swap",
            "key": "├─󰓡",
            "keyColor": "#debece"
        },
        {
            "type": "display",
            "key": "├─󰍹",
            "keyColor": "#debece"
        },
        {
            "type": "brightness",
            "key": "├─󰃞",
            "keyColor": "#debece"
        },
        {
            "type": "battery",
            "key": "├─",
            "keyColor": "#debece"
        },
        {
            "type": "poweradapter",
            "key": "├─",
            "keyColor": "#debece"
        },
        {
            "type": "gamepad",
            "key": "├─",
            "keyColor": "#debece"
        },
        {
            "type": "bluetooth",
            "key": "├─",
            "keyColor": "#debece"
        },
        {
            "type": "sound",
            "key": "╰─",
            "keyColor": "#debece"
        },
        "break",

        {
            "type": "shell",
            "key": "╭─",
            "keyColor": "#f4ba9d"
        },
        {
            "type": "terminal",
            "key": "├─",
            "keyColor": "#f4ba9d"
        },
        {
            "type": "terminalfont",
            "key": "├─",
            "keyColor": "#f4ba9d"
        },
        {
            "type": "lm",
            "key": "├─󰧨",
            "keyColor": "#f4ba9d"
        },
        {
            "type": "de",
            "key": "├─",
            "keyColor": "#f4ba9d"
        },
        {
            "type": "wm",
            "key": "├─",
            "keyColor": "#f4ba9d"
        },
        {
            "type": "theme",
            "key": "├─󰉼",
            "keyColor": "#f4ba9d"
        },
        {
            "type": "icons",
            "key": "├─󰀻",
            "keyColor": "#f4ba9d"
        },
        {
            "type": "wallpaper",
            "key": "╰─󰸉",
            "keyColor": "#f4ba9d"
        },
        "break",

        {
            "type": "title",
            "key": "╭─",
            "format": "{user-name}@{host-name}",
            "keyColor": "#fab1da"
        },
        {
            "type": "os",
            "key": "├─{icon}", // Just get your distro's logo off nerdfonts.com
            "keyColor": "#fab1da"
        },
        {
            "type": "kernel",
            "key": "├─",
            "keyColor": "#fab1da"
        },
        {
            "type": "packages",
            "key": "├─󰏖",
            "keyColor": "#fab1da"
        },
        {
            "type": "uptime",
            "key": "├─󰅐",
            "keyColor": "#fab1da"
        },
        {
            "type": "media",
            "key": "├─󰝚",
            "keyColor": "#fab1da"
        },
        {
            "type": "localip",
            "key": "├─󰩟",
            "compact": true,
            "keyColor": "#fab1da"
        },
        {
            "type": "publicip",
            "key": "├─󰩠",
            "keyColor": "#fab1da",
            "timeout": 1000
        },
        {
            "type": "wifi",
            "key": "├─",
            "format": "{ssid}",
            "keyColor": "#fab1da"
        },
        {
            "type": "locale",
            "key": "╰─",
            "keyColor": "#fab1da"
        }
    ]
}
