{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
	"display": {
		"separator": " "
	},
	"logo": {
		"source": "pearos",
		"padding": {
			"top": 1,
			"left": 2
		},
		"color": {
			"1": "#ffb4a9",
			"2": "#fbbb5d"
		}
	},
	"modules": [
		{
			"type": "host",
			"key": "╭─󰌢",
			"keyColor": "#ffb4a9"
		},
		{
			"type": "cpu",
			"key": "├─󰻠",
			"keyColor": "#ffb4a9"
		},
		{
			"type": "gpu",
			"key": "├─󰍛",
			"keyColor": "#ffb4a9"
		},
		{
			"type": "disk",
			"key": "├─",
			"keyColor": "#ffb4a9"
		},
		{
			"type": "memory",
			"key": "├─󰑭",
			"keyColor": "#ffb4a9"
		},
		{
			"type": "swap",
			"key": "├─󰓡",
			"keyColor": "#ffb4a9"
		},
		{
			"type": "display",
			"key": "├─󰍹",
			"keyColor": "#ffb4a9"
		},
		{
			"type": "brightness",
			"key": "├─󰃞",
			"keyColor": "#ffb4a9"
		},
		{
			"type": "battery",
			"key": "├─",
			"keyColor": "#ffb4a9"
		},
		{
			"type": "poweradapter",
			"key": "├─",
			"keyColor": "#ffb4a9"
		},
		{
			"type": "gamepad",
			"key": "├─",
			"keyColor": "#ffb4a9"
		},
		{
			"type": "bluetooth",
			"key": "├─",
			"keyColor": "#ffb4a9"
		},
		{
			"type": "sound",
			"key": "╰─",
			"keyColor": "#ffb4a9"
		},
		"break",
		{
			"type": "shell",
			"key": "╭─",
			"keyColor": "#fbbb5d"
		},
		{
			"type": "terminal",
			"key": "├─",
			"keyColor": "#fbbb5d"
		},
		{
			"type": "terminalfont",
			"key": "├─",
			"keyColor": "#fbbb5d"
		},
		{
			"type": "lm",
			"key": "├─󰧨",
			"keyColor": "#fbbb5d"
		},
		{
			"type": "de",
			"key": "├─",
			"keyColor": "#fbbb5d"
		},
		{
			"type": "wm",
			"key": "├─",
			"keyColor": "#fbbb5d"
		},
		{
			"type": "theme",
			"key": "├─󰉼",
			"keyColor": "#fbbb5d"
		},
		{
			"type": "icons",
			"key": "╰─󰀻",
			"keyColor": "#fbbb5d"
		},
		"break",
		{
			"type": "title",
			"key": "╭─",
			"format": "{user-name}@{host-name}",
			"keyColor": "#ffb4a9"
		},
		{
			"type": "os",
			"key": "├─{icon}",
			"keyColor": "#ffb4a9"
		},
		{
			"type": "kernel",
			"key": "├─",
			"keyColor": "#ffb4a9"
		},
		{
			"type": "packages",
			"key": "├─󰏖",
			"keyColor": "#ffb4a9"
		},
		{
			"type": "uptime",
			"key": "├─󰅐",
			"keyColor": "#ffb4a9"
		},
		{
			"type": "localip",
			"key": "├─󰩟",
			"compact": true,
			"keyColor": "#ffb4a9"
		},
		{
			"type": "wifi",
			"key": "├─",
			"format": "{ssid}",
			"keyColor": "#ffb4a9"
		},
		{
			"type": "locale",
			"key": "╰─",
			"keyColor": "#ffb4a9"
		}
	]
}
