# iNiR theming template configuration
#
# Templates are rendered by generate_colors_material.py (--render-templates flag).
# The Python pipeline generates Material You colors AND renders all templates in
# a single pass, replacing the previous matugen + Python split.
#
# Template syntax (compatible with former matugen templates):
#   {{colors.primary.dark.hex}}            â†’ "#rrggbb" (dark variant)
#   {{colors.primary.light.hex}}           â†’ "#rrggbb" (light variant)
#   {{colors.primary.default.hex}}         â†’ current mode variant
#   {{colors.primary.default.hex_stripped}} â†’ "rrggbb" (no #)
#   {{colors.primary.dark.rgb}}            â†’ "R, G, B" (decimal triplet)
#   {{image}}                              â†’ wallpaper path
#
# Template manifest: templates.json (declares input/output paths)
# Active t
[templates.kitty]
input_path = '~/.config/matugen/templates/kitty-colors.conf'
output_path = '~/.config/kitty/colors-matugen.conf'
post_hook = 'pkill -SIGUSR1 kitty'
[templates.fastfetch]
input_path = '~/.config/matugen/templates/fastfetch-colors.sh'
output_path = '~/.config/fastfetch/colors.sh'
